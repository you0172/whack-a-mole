{
  "name": "whack-a-mole",
  "version": "1.0.0",
  "description": "A polished, accessible Whack-a-Mole game built with TypeScript, Vite and Web Audio. No assets, no frameworks, 60 seconds of pure reflex.",
  "type": "module",
  "license": "MIT",
  "author": "you0172",
  "homepage": "https://you0172.github.io/whack-a-mole/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/you0172/whack-a-mole.git"
  },
  "bugs": {
    "url": "https://github.com/you0172/whack-a-mole/issues"
  },
  "keywords": [
    "game",
    "whack-a-mole",
    "typescript",
    "vite",
    "web-audio",
    "accessibility",
    "vanilla-ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "size": "node scripts/size-gate.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "verify": "tsc --noEmit && vitest run --coverage && vite build && node scripts/size-gate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
